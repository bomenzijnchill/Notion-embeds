# --- Meta / Instagram app ---
# Uit het Meta for Developers portaal (developers.facebook.com)
IG_APP_ID=
IG_APP_SECRET=

# Redirect URI: in dev je ngrok-URL, exact zoals ingesteld bij Meta.
IG_REDIRECT_URI=https://your-subdomain.ngrok.io/auth/callback

# Id van je eigen IG professional account (wordt ook bij /auth/callback opgeslagen).
IG_USER_ID=

# Gebruik de actuele Graph API-versie.
IG_API_VERSION=v22.0

# Zelfverzonnen string; moet matchen met wat je bij de Meta-webhook invult.
WEBHOOK_VERIFY_TOKEN=verzin-hier-iets-geheims

# --- Server ---
PORT=3000

# Sleutel die de iOS-app meestuurt (header: x-api-key) om de /api/* endpoints
# te beschermen. Verzin een lange willekeurige string en zet dezelfde waarde
# in de iOS-app onder Instellingen.
APP_API_KEY=verzin-hier-een-lange-willekeurige-sleutel
